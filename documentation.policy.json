      "editable": true
    },
    "GENERATED_CURRENT_VIEW": {
      "regeneratable": true
    },
    "CURRENT_STATUS": {
      "editable": true
    }
  },
  "keyDocuments": {
    "LLM.md": "CURRENT_AUTHORITY",
    "INVARIANTS.md": "CURRENT_AUTHORITY",
    "architecture.manifest.json": "CURRENT_AUTHORITY",
    "project.status.json": "CURRENT_STATUS",
    "docs/architecture/decisions/*": "DECISION_RECORD",
    "docs/architecture/continuity/checkpoints/*": "HISTORICAL_SNAPSHOT",
