{
  "name": "evo",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --import tsx apps/api/src/main.ts",
    "dev:worker": "node --env-file-if-exists=.env --import tsx apps/worker/src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:docs": "node --import tsx scripts/validate-llm-docs.ts",
    "test:architecture": "vitest run platform/testing/architecture",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "check": "npm run validate:docs && npm run typecheck && npm run test",
    "start:api": "node dist/apps/api/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "seed:m1": "node --env-file-if-exists=.env --import tsx scripts/seed-m1.ts",
    "test:metadata": "vitest run modules/metadata",
    "test:command": "vitest run modules/command modules/business-data",
    "test:posting": "vitest run modules/posting modules/ledger",
    "seed:demo": "node --env-file-if-exists=.env --import tsx scripts/seed-demo.ts",
    "validate:demo": "node --env-file-if-exists=.env --import tsx scripts/validate-demo.ts",
    "start": "node dist/apps/api/src/main.js",
    "validate:activation-failure-matrix": "node --env-file-if-exists=.env --import tsx scripts/validate-activation-failure-matrix.ts",
    "validate:worker-activation-concurrency": "node --env-file-if-exists=.env --import tsx scripts/validate-worker-activation-concurrency.ts",
    "validate:activation-crash-retry": "node --env-file-if-exists=.env --import tsx scripts/validate-activation-crash-retry.ts",
    "validate:eel-c01-receipt-posting": "node --env-file-if-exists=.env --import tsx scripts/validate-eel-c01-receipt-posting.ts",
    "validate:eel-c01-settlement-allocation": "node --env-file-if-exists=.env --import tsx scripts/validate-eel-c01-settlement-allocation.ts"
  },
  "dependencies": {
    "fastify": "5.12.3",
    "kysely": "0.29.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "decimal.js": "10.6.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "packageManager": "npm@11.19.0"
}
