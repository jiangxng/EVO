{
  "project": "EVO",
  "productCategory": "Enterprise Operating System",
  "contextContractVersion": "1.1",
  "baseline": "v1.0.0-alpha.2",
  "requiredReading": [
    "PHILOSOPHY.md",
    "CONCEPTS.md",
    "INVARIANTS.md",
    "ARCHITECTURE.md",
    "PUBLIC-API.md",
    "architecture.manifest.json"
  ],
  "canonicalRuntimeSpine": [
    "Command",
    "BusinessData",
    "PostingInput",
    "Posting",
    "Ledger",
    "Cost",
    "ValuationPosting",
    "Work",
    "Replay"
  ],
  "sourcePriority": [
    "architecture-change-or-adr",
    "global-invariants",
    "public-api-and-interface-contracts",
    "canonical-architecture-concepts-philosophy",
    "module-context",
    "tests-and-schemas",
    "implementation",
    "comments-and-examples",
    "chat-or-model-memory"
  ],
  "moduleContextPattern": [
    "modules/<module>/README.md",
    "modules/<module>/CONTEXT.md",
    "docs/interfaces/<relevant-interface>.md",
    "docs/adr/<relevant-adr>.md",
    "modules/<module>/tests/**"
  ],
  "rules": {
    "actualWriteBoundary": "Command",
    "businessHistory": "preserved",
    "replayExecutesCommands": false,
    "aiIsSourceOfTruth": false,
    "applicationOwnsIndependentFacts": false,
    "businessLinkInferenceFromMatchingQuantity": false,
    "implicitLatestForHistoricalReplay": false,
    "dimensionPropagation": "explicit-only",
    "costResultWritesLedgerDirectly": false,
    "valuationPostingWritesBusinessData": false
  }
}
