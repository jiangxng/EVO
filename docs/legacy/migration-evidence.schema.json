{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"evo://legacy/migration-evidence.schema.json",
  "title":"Legacy Migration Evidence",
  "type":"object",
  "required":["source","disposition","reason"],
  "properties":{
    "source":{"type":"object","required":["system","locator"],"properties":{"system":{"type":"string"},"locator":{"type":"string"},"legacyId":{},"contentDigest":{"type":"string"}},"additionalProperties":true},
    "disposition":{"enum":["PRESERVED","TRANSFORMED","MERGED","SPLIT","LEGACY_ONLY","DEPRECATED","UNRESOLVED"]},
    "targets":{"type":"array","items":{"type":"object","required":["kind","code"],"properties":{"kind":{"type":"string"},"code":{"type":"string"}}}},
    "reason":{"type":"string","minLength":1},
    "evidence":{"type":"array","items":{"type":"string"}},
    "notes":{"type":"string"}
  },
  "additionalProperties":false
}
